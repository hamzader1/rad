# Quick Open / Go to File (TODO_2 E3; Cmd/Ctrl+P): the explorer folder's
# files, matched by name before path (raddbg's fuzzy match: space-separated
# parts); Up/Down select (wrapping), Enter opens, Esc closes.

open_folder ../fixtures/project
wait_idle
cmd quick_open
wait_idle
expect quick_open_active == 1
expect quick_open_rows == 6
expect quick_open_row 1 == "Cargo.toml"
text "rs"
wait_idle
expect quick_open_rows == 4
expect quick_open_row 1 == "src/lib.rs"
expect quick_open_row 2 == "src/main.rs"
expect quick_open_row 3 == "tests/basic.rs"
expect quick_open_selected == "src/lib.rs"
key down
wait_idle
expect quick_open_selected == "src/main.rs"
key up 2
wait_idle
expect quick_open_selected == "src/util/mod.rs"
key down
wait_idle
expect quick_open_selected == "src/lib.rs"
key down
key return
wait_idle
expect quick_open_active == 0
expect tab == "main.rs"

# a new query each time; parts match anywhere in the path; Esc closes
cmd quick_open
wait_idle
expect quick_open_rows == 6
text "util mod"
wait_idle
expect quick_open_rows == 1
expect quick_open_row 1 == "src/util/mod.rs"
key esc
wait_idle
expect quick_open_active == 0
expect tab == "main.rs"

# the key toggles it
key ctrl+p
wait_idle
expect quick_open_active == 1
text "zzz"
wait_idle
expect quick_open_rows == 0
key ctrl+p
wait_idle
expect quick_open_active == 0
quit
