# Menu widths (user 2026-11-07: raddbg's 50 em menus were too wide): the
# menu bar's menus and the explorer's context menu fit their widest row
# (icon, name, key, a 3 em gap), at least 18 em.

open_folder ../fixtures/project
wait_idle

# File
key alt
wait_idle
key f
wait_idle
expect menu_width_em >= 18
expect menu_width_em < 40
key esc
wait_idle
key esc
wait_idle
expect menu_width_em == 0

# Edit
key alt
wait_idle
key e
wait_idle
expect menu_width_em >= 18
expect menu_width_em < 40
key esc
wait_idle
key esc
wait_idle
expect menu_width_em == 0

# View
key alt
wait_idle
key v
wait_idle
expect menu_width_em >= 18
expect menu_width_em < 40
key esc
wait_idle
key esc
wait_idle
expect menu_width_em == 0

# Window
key alt
wait_idle
key w
wait_idle
expect menu_width_em >= 18
expect menu_width_em < 40
key esc
wait_idle
key esc
wait_idle
expect menu_width_em == 0

# Panel
key alt
wait_idle
key p
wait_idle
expect menu_width_em >= 18
expect menu_width_em < 40
key esc
wait_idle
key esc
wait_idle
expect menu_width_em == 0

# Tab
key alt
wait_idle
key b
wait_idle
expect menu_width_em >= 18
expect menu_width_em < 40
key esc
wait_idle
key esc
wait_idle
expect menu_width_em == 0

# Build
key alt
wait_idle
key u
wait_idle
expect menu_width_em >= 18
expect menu_width_em < 40
key esc
wait_idle
key esc
wait_idle
expect menu_width_em == 0

# Help
key alt
wait_idle
key h
wait_idle
expect menu_width_em >= 18
expect menu_width_em < 40
key esc
wait_idle
key esc
wait_idle
expect menu_width_em == 0

# the explorer's context menu
right_click explorer README.md
wait_frames 3
expect explorer_menu_open == 1
expect menu_width_em >= 18
expect menu_width_em < 40
key esc
wait_frames 3
expect explorer_menu_open == 0
quit
