# Menu widths (user 2026-11-07: raddbg's 50 em menus were too wide, then
# the explorer's 30 em one): the menu bar's menus and the explorer's
# context menus fit their widest row (icon, name, key), at least 18 em,
# and every row still holds its contents. On the Mac menus label keys with
# Apple's symbols (narrower than "Cmd + Option + R"): the explorer's are
# under 25 em there.

open_folder ../fixtures/project
wait_idle

# File
key alt
wait_idle
key f
wait_idle
expect menu_width_em >= 18
expect menu_width_em < 30
expect menu_rows_fit == 1
key esc
wait_idle
key esc
wait_idle
expect menu_width_em == 0

# Edit
key alt
wait_idle
key e
wait_idle
expect menu_width_em >= 18
expect menu_width_em < 30
expect menu_rows_fit == 1
key esc
wait_idle
key esc
wait_idle
expect menu_width_em == 0

# View
key alt
wait_idle
key v
wait_idle
expect menu_width_em >= 18
expect menu_width_em < 30
expect menu_rows_fit == 1
key esc
wait_idle
key esc
wait_idle
expect menu_width_em == 0

# Window
key alt
wait_idle
key w
wait_idle
expect menu_width_em >= 18
expect menu_width_em < 30
expect menu_rows_fit == 1
key esc
wait_idle
key esc
wait_idle
expect menu_width_em == 0

# Panel
key alt
wait_idle
key p
wait_idle
expect menu_width_em >= 18
expect menu_width_em < 30
expect menu_rows_fit == 1
key esc
wait_idle
key esc
wait_idle
expect menu_width_em == 0

# Tab
key alt
wait_idle
key b
wait_idle
expect menu_width_em >= 18
expect menu_width_em < 30
expect menu_rows_fit == 1
key esc
wait_idle
key esc
wait_idle
expect menu_width_em == 0

# Build
key alt
wait_idle
key u
wait_idle
expect menu_width_em >= 18
expect menu_width_em < 30
expect menu_rows_fit == 1
key esc
wait_idle
key esc
wait_idle
expect menu_width_em == 0

# Help (lines of help text, not commands: sized to the longest)
key alt
wait_idle
key h
wait_idle
expect menu_width_em >= 18
expect menu_width_em < 50
expect menu_rows_fit == 1
key esc
wait_idle
key esc
wait_idle
expect menu_width_em == 0

# the explorer's context menus: a folder, a file, the empty space (root)
right_click explorer src
wait_frames 3
expect explorer_menu_open == 1
expect menu_width_em >= 18
expect menu_width_em < 30
expect menu_rows_fit == 1
key esc
wait_frames 3
right_click explorer README.md
wait_frames 3
expect explorer_menu_open == 1
expect menu_width_em >= 18
expect menu_width_em < 30
expect menu_rows_fit == 1
key esc
wait_frames 3
expect explorer_menu_open == 0

only_on mac
right_click explorer README.md
wait_frames 3
expect menu_width_em < 25
expect menu_rows_fit == 1
key esc
wait_frames 3
quit
