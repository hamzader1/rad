# Explorer file operations (TODO_2 D2): New File / New Folder / Rename type a
# name in the tree; Copy / Cut / Paste (a name that exists gets " copy");
# Delete asks first, then moves to the Trash (each run leaves a "sub" folder
# there); the context menu. Open tabs follow renames and moves.

open_folder ../fixtures/explorer_ops
wait_idle
expect explorer_rows == 1
expect explorer_row 1 == "README.txt"

# New File: a name field first in the folder; Enter creates and opens it
cmd explorer_new_file
wait_idle
expect explorer_editing == "new_file"
expect explorer_rows == 2
text "made.txt"
key return
wait_idle
expect explorer_editing == "none"
expect path_exists ../fixtures/explorer_ops/made.txt == 1
expect panel_tabs 1 == "getting_started made.txt"

# Rename (F2): the name without its extension is selected; the tab follows
click explorer made.txt
key f2
wait_idle
expect explorer_editing == "rename"
text "renamed"
key return
wait_idle
expect explorer_editing == "none"
expect path_exists ../fixtures/explorer_ops/made.txt == 0
expect path_exists ../fixtures/explorer_ops/renamed.txt == 1
expect panel_tabs 1 == "getting_started renamed.txt"
expect explorer_selected == "renamed.txt"

# Esc cancels a name
cmd explorer_new_folder
wait_idle
text "never"
key esc
wait_idle
expect explorer_editing == "none"
expect path_exists ../fixtures/explorer_ops/never == 0

# New Folder; Copy a file, Paste into it; Paste again: " copy"
cmd explorer_new_folder
wait_idle
text "sub"
key return
wait_idle
expect path_exists ../fixtures/explorer_ops/sub == 1
click explorer renamed.txt
key ctrl+c
click explorer sub
key ctrl+v
wait_idle
expect path_exists ../fixtures/explorer_ops/sub/renamed.txt == 1
expect path_exists ../fixtures/explorer_ops/renamed.txt == 1
key ctrl+v
wait_idle
expect path_exists "../fixtures/explorer_ops/sub/renamed copy.txt" == 1

# Cut / Paste moves it (onto a file: into that file's folder)
click explorer "renamed copy.txt"
key ctrl+x
click explorer README.txt
key ctrl+v
wait_idle
expect path_exists "../fixtures/explorer_ops/sub/renamed copy.txt" == 0
expect path_exists "../fixtures/explorer_ops/renamed copy.txt" == 1

# the context menu: right click a row; Esc closes it
right_click explorer README.txt
wait_frames 3
expect explorer_menu_open == 1
key esc
wait_frames 3
expect explorer_menu_open == 0

# Delete asks first: Esc keeps it; Enter moves it to the Trash
click explorer sub
cmd explorer_delete
wait_frames 3
expect popup_active == 1
key esc
wait_frames 3
expect popup_active == 0
expect path_exists ../fixtures/explorer_ops/sub == 1
cmd explorer_delete
wait_frames 3
key return
wait_idle
expect popup_active == 0
expect path_exists ../fixtures/explorer_ops/sub == 0

# clean up
delete_file ../fixtures/explorer_ops/renamed.txt
delete_file "../fixtures/explorer_ops/renamed copy.txt"
