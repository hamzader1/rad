#! args: --user:"{work}\session.rad_user"
# Session memory, part 2: rad restarted on part 1's user file restores the
# explorer folder, the panels and the tabs (focused panel and tab too).

wait_idle
expect panel_count == 2
expect explorer_root == "project"
expect explorer_panel_tabs == 1
expect panel == "text"
expect tab == "main.rs"
expect line 1 == "mod util;"
cmd prev_panel
wait_idle
expect tab == "lines_3000.txt"
expect tab_count == 3
expect line 3000 == "line 3000"
cmd prev_tab
wait_idle
expect tab == "edit.txt"
